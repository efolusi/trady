{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trady",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // trady.efolusi.com already had external A records, so Workers custom_domain attach
  // returns 100117. Live traffic uses zone Worker routes (added 2026-11-20). To match
  // komando later: delete those A records in the zone, then switch to custom_domain.
  "routes": [
    { "pattern": "trady.efolusi.com", "zone_name": "efolusi.com" },
    { "pattern": "trady.efolusi.com/*", "zone_name": "efolusi.com" }
  ],
  "workers_dev": true,
  "preview_urls": false
}
